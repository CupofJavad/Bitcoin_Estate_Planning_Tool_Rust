# Database (PostgreSQL). Example for local Docker:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/estate_planning_rust
DATABASE_URL=postgres://postgres:postgres@localhost:5432/estate_planning_rust

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Set to true in production (behind HTTPS) so session cookie is sent with Secure flag. Leave unset or false for local HTTP.
# SECURE_COOKIE=true

# Optional: set to 1000 (or higher) when running integration tests so auth rate limit doesn't trigger (default 10/min).
# RATE_LIMIT_MAX=1000
