# Legacy Vault — Production Docker Compose Environment Template
# Copy to .env.prod (gitignored) and replace all placeholder passwords before deploying.

# Public edge port (8080 behind a TLS terminator like Caddy/Cloudflare/Nginx, or 80)
EDGE_PORT=8080
PUBLIC_SITE_URL=https://estate.yourdomain.com

# PostgreSQL (private internal Docker network only)
POSTGRES_USER=legacyvault
POSTGRES_PASSWORD=REPLACE_WITH_32_CHAR_RANDOM_PASSWORD
POSTGRES_DB=estate_planning_rust

# Connection pool tuning
DB_MAX_CONNECTIONS=25
DB_MIN_CONNECTIONS=2
DB_ACQUIRE_TIMEOUT_SECS=10

# Security & Auth
# Set SECURE_COOKIE=true when serving over HTTPS in production!
SECURE_COOKIE=true
RATE_LIMIT_MAX=30
CORS_EXTRA_ORIGINS=https://estate.yourdomain.com

# Initial admin account bootstrap (or set DISABLE_DEFAULT_ADMIN_SEED=true after first run)
ADMIN_SEED_EMAIL=admin@yourdomain.com
ADMIN_SEED_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
DISABLE_DEFAULT_ADMIN_SEED=false
