# =========================================
# Legacy Vault — Lunaverse deploy env
# Copy to .env and fill; use from workspace root or set DEPLOY_ENV path.
# Rule: no quotes after =. Example: POSTGRES_PASSWORD=mypass
# =========================================

# SSH (for deploy-from-local scripts)
LUNAVERSE_HOST=
LUNAVERSE_SSH_USER=
LUNAVERSE_SSH_PORT=22
LUNAVERSE_SSH_PASSWORD=
# Optional: Tailscale hostname if different from LUNAVERSE_HOST
# LUNAVERSE_SSH_TAILSCALE_HOST=

# PostgreSQL (server where API runs; DB must exist)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=estate_planning_rust
POSTGRES_USER=
POSTGRES_PASSWORD=

# Optional: superuser for create-db (CREATE_DB=1). Must be the real postgres superuser password on the server.
# If unset, script uses POSTGRES_USER/POSTGRES_PASSWORD (app user may not have CREATEDB).
# POSTGRES_SUPERUSER=postgres
# POSTGRES_SUPERUSER_PASSWORD=

# API container (production)
# SECURE_COOKIE=true
# RATE_LIMIT_MAX=100
